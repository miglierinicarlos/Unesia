# Dockerfile.hpc
#
# Multi-stage build for the EOP HPC Engine (v0.2)
# Follows ADR-006: Docker multi-stage, runtime image <= 50 MB
#
# BUILD STAGE
FROM debian:bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ninja-build curl zip unzip tar pkg-config git ca-certificates binutils \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# CMake >= 3.28
RUN curl -fsSL https://github.com/Kitware/CMake/releases/download/v3.28.6/cmake-3.28.6-linux-x86_64.sh \
        -o /tmp/cmake-install.sh \
    && chmod +x /tmp/cmake-install.sh \
    && /tmp/cmake-install.sh --skip-license --prefix=/usr/local \
    && rm /tmp/cmake-install.sh

ENV VCPKG_ROOT=/opt/vcpkg
RUN git clone https://github.com/microsoft/vcpkg.git $VCPKG_ROOT \
    && $VCPKG_ROOT/bootstrap-vcpkg.sh -disableMetrics

WORKDIR /app
COPY vcpkg.json .
RUN --mount=type=secret,id=ACTIONS_CACHE_URL \
    --mount=type=secret,id=ACTIONS_RUNTIME_TOKEN \
    CACHE_URL=$(cat /run/secrets/ACTIONS_CACHE_URL 2>/dev/null || true) && \
    if [ -n "$CACHE_URL" ]; then \
        export ACTIONS_CACHE_URL="$CACHE_URL" && \
        export ACTIONS_RUNTIME_TOKEN=$(cat /run/secrets/ACTIONS_RUNTIME_TOKEN 2>/dev/null || true) && \
        export VCPKG_BINARY_SOURCES="clear;x-gha,readwrite"; \
    fi && \
    $VCPKG_ROOT/vcpkg install --triplet x64-linux --no-print-usage

COPY . .

RUN --mount=type=cache,target=/app/build \
    cmake -S . -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake \
        -DEXODUS_BUILD_TESTS=OFF \
        -DEXODUS_BUILD_BENCHMARKS=OFF \
    && cmake --build build --target hpc_engine \
    && mkdir -p /app/bin_out \
    && cp build/hpc_engine /app/bin_out/hpc_engine \
    && strip /app/bin_out/hpc_engine

# eop_health binary — TCP connect check using HPC_HEALTH_PORT (default 9027)
RUN printf '%s\n' \
    '#include <arpa/inet.h>' '#include <stdlib.h>' '#include <sys/socket.h>' '#include <unistd.h>' \
    'int main(void) {' \
    '    const char* p = getenv("HPC_HEALTH_PORT");' \
    '    const int port = p ? atoi(p) : 9027;' \
    '    const int s = socket(AF_INET, SOCK_STREAM, 0);' \
    '    if (s < 0) return 1;' \
    '    struct sockaddr_in a = {0};' \
    '    a.sin_family = AF_INET; a.sin_port = htons((unsigned short)port);' \
    '    a.sin_addr.s_addr = htonl(0x7f000001);' \
    '    const int rc = connect(s, (struct sockaddr*)&a, sizeof(a));' \
    '    close(s); return rc < 0 ? 1 : 0;' \
    '}' > /tmp/health.c \
    && gcc -Os -o /app/bin_out/eop_health /tmp/health.c && rm /tmp/health.c

# RUNTIME STAGE
# debian:bookworm-slim includes glibc with full NSS stack (required for getaddrinfo DNS resolution)
# distroless/cc-debian12 was rejected: missing libnss_dns.so, hostname resolution fails in K8s
FROM debian:bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*

# Copy the HPC engine binary and health check
COPY --from=builder /app/bin_out/hpc_engine .
COPY --from=builder /app/bin_out/eop_health .

ENTRYPOINT ["./hpc_engine"]
